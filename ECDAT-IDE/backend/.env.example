# ECDAT deploy env — copy to .env and fill. NEVER commit .env.
# Used by docker-compose.vultr.yml + docker-compose.aws.yml.

# AWS GPU box IP (Vultr gateway -> Class B/E). Empty = local fallback mode.
AWS_GPU_HOST=

# Model 11 Gemini (Google AI Studio key; free tier). Needed on the AWS box.
GEMINI_API_KEY=
MODEL11_GEMINI_MODEL=gemini-3.6-flash
MODEL11_BILLING=free

# Groq OpenAI-compatible API for local gateway Models 08-11.
# Keep the real key in the deployment environment; never commit it.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
MODEL8_GROQ_MODEL=qwen/qwen3.8-27b
MODEL9_GROQ_MODEL=qwen/qwen3.8-27b
MODEL10_GROQ_MODEL=qwen/qwen3.8-27b
MODEL11_GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA NIM OpenAI-compatible API for Models 08-11.
# Keep the real key only in the ignored local .env or deployment secret store.
# Comma-separated keys are rotated automatically on 429/401/403 responses.
# Leave EMPTY unless you have a real key — placeholder text breaks key detection.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_API_TIMEOUT=30

# DeepSeek / OpenAI-compatible fallback for Models 08-11.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=

# Featherless AI (OpenAI-compatible) for the Model 08 DeepSeek harness.
# Get a key at https://featherless.ai — NEVER commit the real key.
FEATHERLESS_API_KEY=
FEATHERLESS_API_BASE=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B

# Local Ollama daemon for Models 08-11 (auto-detected; empty = default below).
# Start it with: docker compose --profile llm up -d  (pulls ~9GB+ on first run)
OLLAMA_HOST=http://localhost:11434

# Backend selector per LLM model: auto (ollama -> api key -> simulation),
# or force: ollama | nvidia | groq | remote | simulation.
MODEL8_BACKEND=auto
MODEL9_BACKEND=auto
MODEL10_BACKEND=auto
MODEL11_BACKEND=auto

# Optional: HuggingFace token (gated repos for class-e bases).
HF_TOKEN=

# CDKG Neo4j (Vultr neo4j service). Defaults work out of the box; set to use
# an external AuraDB/self-hosted instance instead.
NEO4J_USER=neo4j
NEO4J_PASSWORD=ecdat-demo-pass

# Vultr batch runs: MODEL_NAME=cryptorobust|gnn_risk|temporal_risk|red_team
BATCH_MODEL=cryptorobust
BATCH_INPUT=/srv/models/model_27_temporal_risk/data
BATCH_OUTPUT=/tmp/ecdat-batch-out

# Preload 04+07 weights at class-e boot (true = slow start, instant first query).
MODEL_E_PRELOAD=false
